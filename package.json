{
    "name": "agri-price-tracker",
    "version": "1.0.0",
    "description": "Tracks daily market prices and weather for farmers, using data.gov.in and OpenWeatherMap.",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "sync:prices": "tsx src/cron/syncPrices.ts",
        "sync:weather": "tsx src/cron/syncWeather.ts"
    },
    "license": "MIT",
    "dependencies": {
        "express": "^4.21.0",
        "pg": "^8.13.0",
        "dotenv": "^16.4.5",
        "node-cron": "^3.0.3",
        "cors": "^2.8.5"
    },
    "devDependencies": {
        "typescript": "^5.6.0",
        "tsx": "^4.19.0",
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.0",
        "@types/pg": "^8.11.10",
        "@types/cors": "^2.8.17",
        "@types/node-cron": "^3.0.11"
    }
}